# Copy to lab.env and edit the two DNS values.  `cp lab.env.example lab.env`
# Every script sources lab.env - it is the single source of truth for the lab.

# ---------------------------------------------------------------- EDIT THESE
# Sub-domain for the lab. Hostnames: shop.<DOMAIN>, api.<DOMAIN>, canary.<DOMAIN>
export DOMAIN="lab.example.com"
# Existing PUBLIC Route 53 hosted zone that contains DOMAIN
# (example.com - or lab.example.com if you delegated the sub-domain to its own zone)
export HOSTED_ZONE="example.com"

# Optional: extra IAM principal(s) that get cluster-admin, comma separated
# (e.g. the role you use in the AWS console, so the EKS console can show workloads)
export ADMIN_PRINCIPAL_ARNS=""

# ---------------------------------------------------------------- USUALLY LEAVE
export AWS_REGION="us-east-1"
export AWS_DEFAULT_REGION="${AWS_REGION}"
export CLUSTER_NAME="istio-gateway-lab"

# Versions (verified compatible on 2026-10-17)
export K8S_VERSION="1.36"            # EKS standard support until Aug 2027; Istio 1.31 supports 1.32-1.37
export KUBECTL_VERSION="v1.36.5"
export HELM_VERSION="v3.22.1"
export TERRAFORM_VERSION="1.16.6"
export ISTIO_VERSION="1.31.2"
export GATEWAY_API_VERSION="v1.6.0"  # the version Istio 1.31 is built and documented against
export LBC_CHART_VERSION="3.6.0"     # AWS Load Balancer Controller v3.6.0 (eks-charts)
export EXTERNAL_DNS_CHART_VERSION="1.23.0"   # ExternalDNS v0.23.0

# App images (pinned)
export PODINFO_V1_IMAGE="ghcr.io/stefanprodan/podinfo:6.14.1"   # "stable"
export PODINFO_V2_IMAGE="ghcr.io/stefanprodan/podinfo:6.15.0"   # "canary"
export HTTPBIN_IMAGE="docker.io/mccutchen/go-httpbin:v2.15.0"
export CURL_IMAGE="docker.io/curlimages/curl:8.16.0"

# Optional add-on (make reviews): Bookinfo reviews v1/v2 + ratings, same images as Istio 1.31.2 samples
export REVIEWS_V1_IMAGE="registry.istio.io/release/examples-bookinfo-reviews-v1:1.20.3"
export REVIEWS_V2_IMAGE="registry.istio.io/release/examples-bookinfo-reviews-v2:1.20.3"
export RATINGS_IMAGE="registry.istio.io/release/examples-bookinfo-ratings-v1:1.20.3"
export REVIEWS_V1_WEIGHT="90"
export REVIEWS_V2_WEIGHT="10"

# Canary starting weights for the weighted rule on shop.<DOMAIN>
export CANARY_V1_WEIGHT="90"
export CANARY_V2_WEIGHT="10"
